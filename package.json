{
  "name": "noir-player-plugin-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone starter repository for Noir Player plugins.",
  "scripts": {
    "check": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run build:plugins",
    "build:plugins": "node scripts/build-plugins.mjs",
    "create-plugin": "node scripts/create-plugin.mjs"
  },
  "dependencies": {
    "@noir-player/plugin-api": "file:vendor/noir-player-plugin-api"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
